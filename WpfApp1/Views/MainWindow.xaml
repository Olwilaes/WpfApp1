<Window x:Class="WpfApp1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        xmlns:view="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel></vm:MainViewModel>
    </Window.DataContext>
    <Grid> 
        <StackPanel Orientation="Horizontal">
            <StackPanel>
            <view:MethodsView></view:MethodsView>
                <Button Content="Invoke selectedMethod with selected variables" Command="{Binding InvokeMethodCommand}"></Button>
            </StackPanel>
            <view:VariablesView></view:VariablesView>
            <view:LogMessagesView></view:LogMessagesView>
        </StackPanel>

    </Grid>
</Window>
